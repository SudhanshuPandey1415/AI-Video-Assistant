# Auto detect text files and perform LF normalization on checkin
* text=auto

# Explicitly declare text files you always want to be normalized
*.py text eol=lf
*.html text eol=lf
*.css text eol=lf
*.js text eol=lf
*.md text eol=lf
*.txt text eol=lf
*.env.example text eol=lf
*.json text eol=lf
*.yml text eol=lf
*.yaml text eol=lf

# Denote all binary files that should not be modified
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.wav binary
*.mp3 binary
*.mp4 binary
