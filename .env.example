# ==============================================================================
# AI Video Assistant - Environment Configuration Template
# Duplicate this file as '.env' and populate your respective API keys.
# DO NOT commit your actual '.env' file with real keys to GitHub.
# ==============================================================================

# Mistral AI API Key (Required for Summarization, Extraction, RAG, and Hinglish STT via Voxtral)
# Obtain your key at: https://console.mistral.ai/
MISTRAL_API_KEY=your_mistral_api_key_here

# Local Whisper Speech-to-Text Model Size
# Options: tiny, base, small, medium, large-v2, large-v3 (Default: small)
WHISPER_MODEL=small

# Google Gemini API Key (Optional / for translation or multimodal tasks)
GEMINI_API_KEY=your_gemini_api_key_here

# Sarvam AI API Key (Optional / fallback speech-to-text)
# SARVAM_API_KEY=your_sarvam_api_key_here
